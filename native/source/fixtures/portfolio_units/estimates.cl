& limit econ::budget(10000@cny_cent).
& amber_cost econ::cost(amber,6000@cny_cent).
& amber_output econ::output(amber,70@items).
& amber_review econ::verified(amber).
& blue_cost econ::cost(blue,8500@cny_cent).
& blue_output econ::output(blue,95@items).
& blue_review econ::verified(blue).
& green_cost econ::cost(green,7000@cny_cent).
& green_output econ::output(green,60@items).
& green_review econ::verified(green).
& red_cost econ::cost(red,10500@cny_cent).
& red_output econ::output(red,135@items).
& red_review econ::verified(red).
& gray_cost econ::cost(gray,4000@cny_cent).
& gray_output econ::output(gray,150@items).
& violet_cost econ::cost(violet,5000@cny_cent).
& violet_output econ::output(violet,200@items).
& violet_review_a econ::verified(violet).
& violet_review_b !econ::verified(violet).
